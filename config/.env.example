# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/document_digitization

# Redis/Celery Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Storage Configuration
STORAGE_BACKEND=s3
LOCAL_STORAGE_PATH=./storage

# S3/MinIO Configuration
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=document-digitization
S3_REGION=us-east-1

# QC Thresholds
QC_MIN_DPI=300
QC_MAX_SKEW_ANGLE=2.0
QC_MIN_CONTRAST_SCORE=0.3
QC_MAX_BORDER_PERCENTAGE=10

# HTR Configuration
HTR_MODEL=microsoft/trocr-large-handwritten
HTR_CONFIDENCE_THRESHOLD=0.70
HTR_AUTO_ACCEPT_THRESHOLD=0.85
HTR_USE_GPU=true
HTR_BATCH_SIZE=8

# OCR Configuration
OCR_CONFIDENCE_THRESHOLD=0.85

# Processing
MAX_WORKERS=10
PROCESSING_TIMEOUT=300

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
DEBUG=false
